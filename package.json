{
  "name": "pi-learn",
  "version": "1.0.0",
  "description": "Personal exam tutor for Pi with resumable Obsidian notes, retrieval practice and evidence-aware syllabus priorities.",
  "main": "extensions/md-log.ts",
  "keywords": [
    "pi-package",
    "learning",
    "pedagogy",
    "obsidian",
    "education",
    "quiz",
    "latex",
    "mermaid",
    "svg"
  ],
  "author": "Josephxcx",
  "repository": {
    "type": "git",
    "url": "https://github.com/Josephxcx/pi-learn.git"
  },
  "homepage": "https://github.com/Josephxcx/pi-learn#readme",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:deps": "node scripts/check-deps.js",
    "check:package": "npm pack --dry-run",
    "visual:examples": "node scripts/build-visual-examples.mts",
    "visual:verify": "node scripts/build-visual-examples.mts --verify"
  },
  "pi": {
    "extensions": [
      "./extensions/md-log.ts"
    ],
    "skills": [
      "./skills/pi-learn",
      "./skills/frontend-design"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0 || >=1.1.0 <1.2.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "skills/",
    "examples/",
    "docs/teaching-design.md",
    "docs/exam-context.md",
    "docs/technical-guide.md",
    "scripts/check-deps.js",
    "README.md",
    "LICENSE",
    "assets/",
    "scripts/build-visual-examples.mts"
  ],
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "saxes": "^6.0.0",
    "typebox": "1.3.27",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "playwright": "^1.64.0"
  }
}
